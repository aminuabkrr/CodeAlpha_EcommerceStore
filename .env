# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local example:  mongodb://localhost:27017/codealpha_ecommerce
# Atlas example:  mongodb+srv://<user>:<password>@cluster0.mongodb.net/codealpha_ecommerce
MONGODB_URI=mongodb://localhost:27017/codealpha_ecommerce

# JWT secret — use a long random string, never reuse across projects
JWT_SECRET=replace_this_with_a_long_random_string
